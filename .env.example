# Public URL of Grafana (Grafana runs directly on port 3000).
GRAFANA_ROOT_URL=http://SERVER_IP:3000

# InfluxDB 1.8 (InfluxQL). k6 writes into this database.
# Authentication is enabled - this user is used by both Grafana and k6.
# The admin user is only created on the FIRST initialization of an empty volume.
INFLUX_DB=k6
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
